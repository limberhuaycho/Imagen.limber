rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'limberhuaychoquispe81@gmail.com';
    }

    function miUid() {
      return request.auth != null ? request.auth.uid : '';
    }

    function codigoDe(numero) {
      return get(/databases/$(database)/documents/codigos/$(numero));
    }

    // =================================================================
    // /numeros/{numero}
    // Directorio de quien tiene cuenta.
    // =================================================================
    match /numeros/{numero} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if esAdmin();
    }

    // =================================================================
    // /codigos/{numero}
    //
    // La app genera el codigo sola y el administrador lo ve en el panel
    // para mandarlo a mano por correo o WhatsApp.
    //
    // Solo el admin puede LEERLOS: nadie mas puede ver un codigo, ni
    // siquiera quien lo esta escribiendo.
    //
    // Cualquiera autenticado puede CREAR un codigo, pero unicamente si
    // ese numero todavia no tiene uno. Asi nadie puede pisar el codigo
    // que otro ya genero.
    // =================================================================
    match /codigos/{numero} {
      allow read: if esAdmin();

      allow create: if esAdmin()
        || (request.auth != null
            && !exists(/databases/$(database)/documents/codigos/$(numero))
            && request.resource.data.keys().hasOnly(
                 ['numero', 'codigo', 'expira', 'usado', 'intentos', 'creado'])
            && request.resource.data.numero == numero
            && request.resource.data.codigo is string
            && request.resource.data.codigo.size() == 6
            && request.resource.data.expira is timestamp
            && request.resource.data.usado == false);

      // El admin puede editar o borrar cuando lo necesite.
      allow update, delete: if esAdmin();
    }

    // =================================================================
    // /intentos/{uid}
    // El usuario escribe el codigo que recibio. Las reglas lo comparan
    // con el guardado: si no coinciden, la escritura se rechaza sola.
    // =================================================================
    match /intentos/{uid} {
      allow read: if miUid() == uid;

      allow create: if miUid() == uid
        && request.resource.data.keys().hasOnly(['numero', 'codigo', 'fecha'])
        && codigoDe(request.resource.data.numero).data.codigo
             == request.resource.data.codigo
        && codigoDe(request.resource.data.numero).data.usado == false
        && codigoDe(request.resource.data.numero).data.expira > request.time;
    }

    // =================================================================
    // /solicitudes/{id}
    // Ya no se usa: el codigo se genera directo. Se deja la regla
    // cerrada por si queda algun registro viejo.
    // =================================================================
    match /solicitudes/{id} {
      allow read, write: if esAdmin();
    }

    // =================================================================
    // /usuarios/{uid}
    // =================================================================
    match /usuarios/{uid} {
      allow read, write: if esAdmin() || miUid() == uid;
    }

    // =================================================================
    // /mensajes/{conversacionId}/mensaje/{mensajeId}
    // =================================================================
    match /mensajes/{conversacionId}/mensaje/{mensajeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.autor == miUid();
      allow update, delete: if esAdmin();
    }

    // =================================================================
    // /config/{documento}
    // =================================================================
    match /config/{documento} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}