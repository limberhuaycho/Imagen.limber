rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'limberhuaychoquispe81@gmail.com';
    }

    function miUid() {
      return request.auth != null ? request.auth.uid : '';
    }

    match /numeros/{clave} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if esAdmin();
    }

    match /codigos/{clave} {
      allow read: if esAdmin();
      allow create, update, delete: if esAdmin();
    }

    match /solicitudes/{id} {
      allow read, delete: if esAdmin();
      allow create: if request.auth != null;
      allow update: if esAdmin();
    }

    match /usuarios/{uid} {
      allow read, write: if esAdmin() || (request.auth != null && miUid() == uid);
    }

    match /mensajes/{conversacionId}/mensaje/{mensajeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if esAdmin();
    }

    match /config/{documento} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}