rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'limberhuaychoquispe81@gmail.com';
    }

    function miUid() {
      return request.auth != null ? request.auth.uid : '';
    }

    // Numero completo de la empresa principal: 51 + 73265343.
    function esMiEmpresa(numero) {
      return numero == '59173265343';
    }

    function codigoDe(numero) {
      return get(/databases/$(database)/documents/codigos/$(numero));
    }

    // Ficha de la sesion: que numero esta comprobando y cuantos
    // intentos lleva. Es el nudo que amarra uid -> numero -> codigo.
    function miVerificacion() {
      return get(/databases/$(database)/documents/verificaciones/$(miUid()));
    }

    // Firestore no admite 'const', asi que estos dos limites van como
    // funciones. Se invocan escribiendoles los parentesis.
    function maxIntentos() {
      return 5;
    }

    function esperaReenvioMinutos() {
      return 1;
    }

    // =================================================================
    // /numeros/{numero}
    // Directorio. Dice si un numero existe y si la empresa lo verifico.
    // =================================================================
    match /numeros/{numero} {

      allow read: if request.auth != null;
      allow create: if request.auth != null;

      // El admin puede cambiarlo todo. El usuario solo actualiza su
      // foto, nombre y los campos de su ficha: nunca puede marcarse
      // verificado ni cambiar el uid de otra persona.
      allow update: if esAdmin() || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fotoUrl', 'nombre', 'actualizado', 'disponible'])
        && (resource.data.uid == miUid() || resource.data.uid == null)
      );

      allow delete: if esAdmin();
    }

    // =================================================================
    // /codigos/{numero}
    // La app GENERA el codigo y lo escribe aqui. La app no puede leerlo:
    // solo lo ve el administrador. Asi nadie se verifica solo.
    //
    // Para poder escribir hace falta dos cosas a la vez: haber
    // reclamado ese numero en /verificaciones y poner su propio uid en
    // el documento. Sin las dos, escribir codigos/otroNumero se rechaza.
    // =================================================================
    match /codigos/{numero} {

      allow read: if esAdmin();

      // El administrador tambien puede crear codigos a mano (seccion 1
      // del panel), y ahi no hace falta la ficha de verificacion.
      allow create: if esAdmin() || (
        request.auth != null
        && request.resource.data.keys()
             .hasOnly(['numero', 'codigo', 'uid', 'expira', 'intentos', 'usado', 'creado'])
        && request.resource.data.numero == numero
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() == 6
        && request.resource.data.usado == false
        && request.resource.data.uid == miUid()
        && miVerificacion().data.numero == numero
      );

      // El admin puede corregirlo o borrarlo. El usuario solo sobre el
      //  documento del numero que tiene reclamado en su ficha de
      //  verificacion. Se permiten dos cosas y ninguna mas:
      //  - marcarlo usado tras verificarlo;
      //  - regenerarlo: codigo nuevo de 6 digitos, usado=false,
      //    intentos=0, creado y expira de ahora.
      //
      //  OJO con el uid: antes se pedia resource.data.uid == miUid().
      //  Eso rompia el caso normal de "el numero ya tiene codigo", porque
      //  al renovar la sesion anonima el uid cambia y el set() sobre un
      //  documento existente es un update, no un create: la escritura
      //  se rechazaba con PERMISSION_DENIED y el usuario veia "No se
      //  pudo generar el codigo". La pertenencia se comprueba con la
      //  ficha de verificacion, que ya ampara uid -> numero, asi que no
      //  se abre la coleccion: solo se toca codigos/{numero} y solo si
      //  ese numero es el que esta sesion ha reclamado.
      allow update: if esAdmin() || (
        request.auth != null
        && miVerificacion().data.numero == numero
        && (
          // Marcarlo usado: una sola transicion, de false a true.
          (
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['usado'])
            && request.resource.data.usado == true
            && resource.data.usado == false
          )
          || (
            // Regenerarlo: solo los campos del codigo, siempre con la
            // misma forma y siempre empezando por un codigo sin usar.
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasAll(['codigo', 'expira', 'usado', 'creado'])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'numero', 'codigo', 'uid', 'expira', 'intentos',
                   'usado', 'creado'
                 ])
            // No se inventa otro documento ni otro numero.
            && request.resource.data.numero == numero
            && request.resource.data.keys().hasAll([
                 'numero', 'codigo', 'uid', 'expira', 'intentos',
                 'usado', 'creado'
               ])
            && request.resource.data.codigo is string
            && request.resource.data.codigo.size() == 6
            && request.resource.data.codigo != resource.data.codigo
            && request.resource.data.usado == false
            && request.resource.data.intentos == 0
            // "creado" lo pone el servidor (serverTimestamp), asi que da
            // igual que el reloj del telefono vaya atras o adelante.
            && request.resource.data.creado == request.time
            // La caducidad se comprueba con margen: se acepta un reloj
            // desincronizado, pero no una fecha absurda. El uso del
            // codigo sigue exigiendo expira > request.time en /intentos.
            && request.resource.data.expira is timestamp
            && request.resource.data.expira > request.time
            && request.resource.data.expira
                 <= request.time + duration.value(1, 'd')
          )
        )
      );

      allow delete: if esAdmin();
    }

    // =================================================================
    // /verificaciones/{uid}
    // Ficha propia de la sesion: que numero se esta comprobando y
    // cuantos intentos lleva. Solo su dueno la ve y la escribe.
    // =================================================================
    match /verificaciones/{uid} {

      allow read: if esAdmin() || miUid() == uid;

      allow create: if miUid() == uid
        && request.resource.data.keys()
             .hasOnly(['numero', 'intentos', 'creado', 'expira'])
        && request.resource.data.numero is string
        && request.resource.data.numero.size() >= 8;

      // El contador SOLO puede subir. Rebajarlo solo se permite al pedir
      // otro codigo, y con un minuto de espera entre reenvios.
      //
      // "expira" es la copia de la caducidad del codigo que pidio esta
      // sesion. Se permite solo cuando el contador vuelve a cero, o sea
      // en el mismo movimiento que se regenera el codigo: asi no se
      // puede tocar nada mas de esta ficha.
      allow update: if esAdmin() || (
        miUid() == uid
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['intentos'])
            && request.resource.data.intentos > resource.data.intentos
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['intentos', 'reenviado'])
            && request.resource.data.intentos == 0
            // Si nunca hubo reenvio, la espera se cuenta desde que se
            // empezo esta verificacion: si no, el primer reenvio
            // quedaria bloqueado para siempre.
            && request.time > resource.data.get('reenviado', resource.data.creado)
                  + duration.value(esperaReenvioMinutos(), 'm')
          )
          || (
            // Al regenerar el codigo se guarda tambien su caducidad.
            // Solo tiene que ser una fecha futura: el valor real lo
            // decide la app y no se usa para autorizar nada.
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['intentos', 'reenviado', 'expira'])
            && request.resource.data.intentos == 0
            && request.resource.data.expira is timestamp
            && request.resource.data.expira > request.time
            && request.resource.data.expira
                 <= request.time + duration.value(1, 'd')
            && request.time > resource.data.get('reenviado', resource.data.creado)
                  + duration.value(esperaReenvioMinutos(), 'm')
          )
          || (
            // Cambiar de numero dentro de la misma sesion. No reinicia
            // el contador ni concede nada que no tuviera antes.
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['numero'])
          )
        )
      );

      allow delete: if esAdmin();
    }

    // =================================================================
    // /intentos/{uid}
    // La app escribe el codigo que tecleo el usuario. Las reglas lo
    // comparan con el real usando get(): si no coincide, la escritura
    // se rechaza sola y el usuario nunca puede leer el codigo bueno.
    // =================================================================
    match /intentos/{uid} {

      allow read: if miUid() == uid;

      allow create: if miUid() == uid
        && request.resource.data.keys().hasOnly(['numero', 'codigo', 'fecha'])
        && request.resource.data.numero == miVerificacion().data.numero
        && request.resource.data.codigo
             == codigoDe(request.resource.data.numero).data.codigo
        && codigoDe(request.resource.data.numero).data.usado == false
        && codigoDe(request.resource.data.numero).data.expira > request.time
        && miVerificacion().data.intentos <= maxIntentos();

      allow delete: if miUid() == uid;
    }

    // =================================================================
    // /solicitudes/{id}
    // =================================================================
    match /solicitudes/{id} {
      allow read, delete: if esAdmin();
      allow create: if request.auth != null;
      allow update: if esAdmin();
    }

    // =================================================================
    // /usuarios/{uid}
    // El perfil de la persona: lo que escribe "Editar perfil" y ve el
    // resto. Cada quien escribe solo el suyo.
    //
    // OJO: "verificado" y "esEmpresa" NO pueden escribirse desde la app.
    // Ahora estan en la lista de campos permitidos porque el alta inicial
    // los escribe la propia sesion, pero no se usan para autorizar nada:
    // lo que decide si una cuenta es de empresa es /numeros/{numero}, y
    // ahi "verificado" es solo del administrador. Aun asi se dejan fuera
    // los campos de administracion para que un cambio futuro de reglas no
    // los dejara pasar sin querer.
    // =================================================================
    match /usuarios/{uid} {

      allow read: if esAdmin() || miUid() == uid;

      allow create: if miUid() == uid
        && request.resource.data.keys().hasOnly([
             'numero', 'nombre', 'fotoUrl', 'esEmpresa', 'usuario',
             'estado', 'empresa', 'actividad', 'direccion', 'correo',
             'telefono', 'sitioWeb', 'instagram', 'facebook', 'actualizado'
           ]);

      allow update: if esAdmin() || (
        miUid() == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'numero', 'nombre', 'fotoUrl', 'esEmpresa', 'usuario',
               'estado', 'empresa', 'actividad', 'direccion', 'correo',
               'telefono', 'sitioWeb', 'instagram', 'facebook', 'actualizado'
             ])
      );

      allow delete: if esAdmin();
    }

    // =================================================================
    // /dispositivos/{idDispositivo}
    // Un documento por telefono real. La app escribe aqui los datos que
    // salen de android.os.Build al entrar: marca, modelo, version de
    // Android, pantalla, red, pais, fecha de instalacion, etc.
    //
    // El identificador es un hash del ANDROID_ID del propio telefono, asi
    // que reinstalar la app no crea un equipo nuevo. Quien escribe es
    // siempre la propia sesion: nadie puede registrar un dispositivo en
    // nombre de otro uid ni cambiar de dueno un documento existente.
    // =================================================================
    match /dispositivos/{idDispositivo} {

      allow read: if esAdmin() || (
        request.auth != null && resource.data.uid == request.auth.uid
      );

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
             'uid', 'numero', 'idDispositivo', 'androidId', 'marca',
             'modelo', 'android', 'sdk', 'activo', 'ultimaConexion'
           ]);

      // Al volver a entrar se actualiza todo menos "uid", que es la
      // pertenencia del documento: si se pudiera cambiar, un usuario
      // podria robarle el equipo a otra cuenta escribiendolo.
      allow update: if esAdmin() || (
        request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
      );

      allow delete: if esAdmin();
    }

    // =================================================================
    // /mensajes/{conversacionId}/mensaje/{mensajeId}
    // =================================================================
    match /mensajes/{conversacionId}/mensaje/{mensajeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.autor == miUid();
      allow update: if esAdmin() || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['leido'])
      );
      allow delete: if esAdmin() || (
        request.auth != null && resource.data.autor == miUid()
      );
    }

    // =================================================================
    // /config/{documento}
    // El admin publica aqui los numeros autorizados.
    // =================================================================
    match /config/{documento} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}