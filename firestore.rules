rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'limberhuaychoquispe81@gmail.com';
    }

    function miUid() {
      return request.auth != null ? request.auth.uid : '';
    }

    // Membresia por RUTA, no por un campo.
    //
    // Existe un documento /conversaciones/{id}/miembros/{uid} por cada
    // participante. Es lo que permite que las consultas funcionen: las
    // reglas pueden comprobar la pertenencia con exists() sobre una ruta
    // que sale del propio path de la regla, y eso Firestore SI lo sabe
    // evaluar para una lista. Con un campo "participantes" dentro del
    // documento habria que hacer get() del mismo documento que se esta
    // comprobando, y en una consulta eso no se puede resolver: la lista
    // entera fallaria con "missing or insufficient permissions".
    function soyParticipante(conversacionId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/conversaciones/$(conversacionId)/miembros/$(miUid()));
    }

    function soyAdminDe(conversacionId) {
      return soyParticipante(conversacionId)
        && miUid() in get(/databases/$(database)/documents/conversaciones/$(conversacionId))
             .data.administradores.split(',');
    }

    // Numero completo de la empresa principal: 51 + 73265343.
    function esMiEmpresa(numero) {
      return numero == '59173265343';
    }

    function codigoDe(numero) {
      return get(/databases/$(database)/documents/codigos/$(numero));
    }

    // Ficha de la sesion: que numero esta comprobando y cuantos
    // intentos lleva. Es el nudo que amarra uid -> numero -> codigo.
    function miVerificacion() {
      return get(/databases/$(database)/documents/verificaciones/$(miUid()));
    }

    // Firestore no admite 'const', asi que estos dos limites van como
    // funciones. Se invocan escribiendoles los parentesis.
    function maxIntentos() {
      return 5;
    }

    function esperaReenvioMinutos() {
      return 1;
    }

    // =================================================================
    // /numeros/{numero}
    // Directorio. Dice si un numero existe y si la empresa lo verifico.
    // =================================================================
    match /numeros/{numero} {

      allow read: if request.auth != null;
      allow create: if request.auth != null;

      // El admin puede cambiarlo todo. El usuario solo actualiza su
      // foto, nombre y los campos de su ficha: nunca puede marcarse
      // verificado ni cambiar el uid de otra persona.
      allow update: if esAdmin() || (
        request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fotoUrl', 'nombre', 'actualizado', 'disponible', 'esEmpresa'])
        && (resource.data.uid == miUid() || resource.data.uid == null)
      );

      allow delete: if esAdmin();
    }

    // =================================================================
    // /codigos/{numero}
    // La app GENERA el codigo y lo escribe aqui. La app no puede leerlo:
    // solo lo ve el administrador. Asi nadie se verifica solo.
    //
    // Para poder escribir hace falta dos cosas a la vez: haber
    // reclamado ese numero en /verificaciones y poner su propio uid en
    // el documento. Sin las dos, escribir codigos/otroNumero se rechaza.
    // =================================================================
    match /codigos/{numero} {

      allow read: if esAdmin();

      // El administrador tambien puede crear codigos a mano (seccion 1
      // del panel), y ahi no hace falta la ficha de verificacion.
      allow create: if esAdmin() || (
        request.auth != null
        && request.resource.data.keys()
             .hasOnly(['numero', 'codigo', 'uid', 'expira', 'intentos', 'usado', 'creado'])
        && request.resource.data.numero == numero
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() == 6
        && request.resource.data.usado == false
        && request.resource.data.uid == miUid()
        && miVerificacion().data.numero == numero
      );

      // El admin puede corregirlo o borrarlo. El usuario solo sobre el
      //  documento del numero que tiene reclamado en su ficha de
      //  verificacion. Se permiten dos cosas y ninguna mas:
      //  - marcarlo usado tras verificarlo;
      //  - regenerarlo: codigo nuevo de 6 digitos, usado=false,
      //    intentos=0, creado y expira de ahora.
      //
      //  OJO con el uid: antes se pedia resource.data.uid == miUid().
      //  Eso rompia el caso normal de "el numero ya tiene codigo", porque
      //  al renovar la sesion anonima el uid cambia y el set() sobre un
      //  documento existente es un update, no un create: la escritura
      //  se rechazaba con PERMISSION_DENIED y el usuario veia "No se
      //  pudo generar el codigo". La pertenencia se comprueba con la
      //  ficha de verificacion, que ya ampara uid -> numero, asi que no
      //  se abre la coleccion: solo se toca codigos/{numero} y solo si
      //  ese numero es el que esta sesion ha reclamado.
      allow update: if esAdmin() || (
        request.auth != null
        && miVerificacion().data.numero == numero
        && (
          // Marcarlo usado: una sola transicion, de false a true.
          (
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['usado'])
            && request.resource.data.usado == true
            && resource.data.usado == false
          )
          || (
            // Regenerarlo: solo los campos del codigo, siempre con la
            // misma forma y siempre empezando por un codigo sin usar.
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasAll(['codigo', 'expira', 'usado', 'creado'])
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'numero', 'codigo', 'uid', 'expira', 'intentos',
                   'usado', 'creado'
                 ])
            // No se inventa otro documento ni otro numero.
            && request.resource.data.numero == numero
            && request.resource.data.keys().hasAll([
                 'numero', 'codigo', 'uid', 'expira', 'intentos',
                 'usado', 'creado'
               ])
            && request.resource.data.codigo is string
            && request.resource.data.codigo.size() == 6
            && request.resource.data.codigo != resource.data.codigo
            && request.resource.data.usado == false
            && request.resource.data.intentos == 0
            // "creado" lo pone el servidor (serverTimestamp), asi que da
            // igual que el reloj del telefono vaya atras o adelante.
            && request.resource.data.creado == request.time
            // La caducidad se comprueba con margen: se acepta un reloj
            // desincronizado, pero no una fecha absurda. El uso del
            // codigo sigue exigiendo expira > request.time en /intentos.
            && request.resource.data.expira is timestamp
            && request.resource.data.expira > request.time
            && request.resource.data.expira
                 <= request.time + duration.value(1, 'd')
          )
        )
      );

      allow delete: if esAdmin();
    }

    // =================================================================
    // /verificaciones/{uid}
    // Ficha propia de la sesion: que numero se esta comprobando y
    // cuantos intentos lleva. Solo su dueno la ve y la escribe.
    // =================================================================
    match /verificaciones/{uid} {

      allow read: if esAdmin() || miUid() == uid;

      allow create: if miUid() == uid
        && request.resource.data.keys()
             .hasOnly(['numero', 'intentos', 'creado', 'expira'])
        && request.resource.data.numero is string
        && request.resource.data.numero.size() >= 8;

      // El contador SOLO puede subir. Rebajarlo solo se permite al pedir
      // otro codigo, y con un minuto de espera entre reenvios.
      //
      // "expira" es la copia de la caducidad del codigo que pidio esta
      // sesion. Se permite solo cuando el contador vuelve a cero, o sea
      // en el mismo movimiento que se regenera el codigo: asi no se
      // puede tocar nada mas de esta ficha.
      allow update: if esAdmin() || (
        miUid() == uid
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['intentos'])
            && request.resource.data.intentos > resource.data.intentos
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['intentos', 'reenviado'])
            && request.resource.data.intentos == 0
            // Mismo criterio que mas abajo: el primer codigo de la sesion
            // no espera, los siguientes si. Ver la nota larga del bloque
            // de ['intentos','reenviado','expira'].
            && (
              !('reenviado' in resource.data)
              || request.time > resource.data.reenviado
                    + duration.value(esperaReenvioMinutos(), 'm')
            )
          )
          || (
            // Al regenerar el codigo se guarda tambien su caducidad.
            // Solo tiene que ser una fecha futura: el valor real lo
            // decide la app y no se usa para autorizar nada.
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['intentos', 'reenviado', 'expira'])
            && request.resource.data.intentos == 0
            && request.resource.data.expira is timestamp
            && request.resource.data.expira > request.time
            && request.resource.data.expira
                 <= request.time + duration.value(1, 'd')
            // AQUI ESTA EL ARREGLO DEL BUG "No se pudo generar el codigo".
            //
            // Antes la espera se media siempre desde "creado", asi que el
            // PRIMER codigo de una sesion recien abierta fallaba siempre:
            // la app acababa de crear la ficha con creado=ahora y, un
            // instante despues, la regla exigia que hubiera pasado un
            // minuto entero. El usuario veia "No se pudo generar el
            // codigo" sin haber hecho nada mal.
            //
            // Ahora la espera solo cuenta cuando YA hubo un reenvio
            // anterior ("reenviado" existe). El primer codigo es libre,
            // y los siguientes siguen respetando el minuto de descanso
            // para que nadie pueda machacar codigos/{numero} sin parar.
            && (
              !('reenviado' in resource.data)
              || request.time > resource.data.reenviado
                    + duration.value(esperaReenvioMinutos(), 'm')
            )
          )
          || (
            // Cambiar de numero dentro de la misma sesion. No reinicia
            // el contador ni concede nada que no tuviera antes.
            request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['numero'])
          )
        )
      );

      allow delete: if esAdmin();
    }

    // =================================================================
    // /intentos/{uid}
    // La app escribe el codigo que tecleo el usuario. Las reglas lo
    // comparan con el real usando get(): si no coincide, la escritura
    // se rechaza sola y el usuario nunca puede leer el codigo bueno.
    // =================================================================
    match /intentos/{uid} {

      allow read: if miUid() == uid;

      allow create: if miUid() == uid
        && request.resource.data.keys().hasOnly(['numero', 'codigo', 'fecha'])
        && request.resource.data.numero == miVerificacion().data.numero
        && request.resource.data.codigo
             == codigoDe(request.resource.data.numero).data.codigo
        && codigoDe(request.resource.data.numero).data.usado == false
        && codigoDe(request.resource.data.numero).data.expira > request.time
        && miVerificacion().data.intentos <= maxIntentos();

      allow delete: if miUid() == uid;
    }

    // =================================================================
    // /solicitudes/{id}
    // =================================================================
    match /solicitudes/{id} {
      allow read, delete: if esAdmin();
      allow create: if request.auth != null;
      allow update: if esAdmin();
    }

    // =================================================================
    // /usuarios/{uid}
    // El perfil de la persona: lo que escribe "Editar perfil" y ve el
    // resto. Cada quien escribe solo el suyo.
    //
    // OJO: "verificado" y "esEmpresa" NO pueden escribirse desde la app.
    // Ahora estan en la lista de campos permitidos porque el alta inicial
    // los escribe la propia sesion, pero no se usan para autorizar nada:
    // lo que decide si una cuenta es de empresa es /numeros/{numero}, y
    // ahi "verificado" es solo del administrador. Aun asi se dejan fuera
    // los campos de administracion para que un cambio futuro de reglas no
    // los dejara pasar sin querer.
    // =================================================================
    match /usuarios/{uid} {

      allow read: if esAdmin() || miUid() == uid;

      allow create: if miUid() == uid
        && request.resource.data.keys().hasOnly([
             'numero', 'nombre', 'fotoUrl', 'esEmpresa', 'usuario',
             'estado', 'empresa', 'actividad', 'direccion', 'correo',
             'telefono', 'sitioWeb', 'instagram', 'facebook', 'actualizado'
           ]);

      allow update: if esAdmin() || (
        miUid() == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'numero', 'nombre', 'fotoUrl', 'esEmpresa', 'usuario',
               'estado', 'empresa', 'actividad', 'direccion', 'correo',
               'telefono', 'sitioWeb', 'instagram', 'facebook', 'actualizado'
             ])
      );
      allow delete: if esAdmin();
    }

    // =================================================================
    // /dispositivos/{idDispositivo}
    // Un documento por telefono real. La app escribe aqui los datos que
    // salen de android.os.Build al entrar: marca, modelo, version de
    // Android, pantalla, red, pais, fecha de instalacion, etc.
    //
    // El identificador es un hash del ANDROID_ID del propio telefono, asi
    // que reinstalar la app no crea un equipo nuevo. Quien escribe es
    // siempre la propia sesion: nadie puede registrar un dispositivo en
    // nombre de otro uid ni cambiar de dueno un documento existente.
    // =================================================================
    match /dispositivos/{idDispositivo} {

      allow read: if esAdmin() || (
        request.auth != null && resource.data.uid == request.auth.uid
      );

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll([
             'uid', 'numero', 'idDispositivo', 'androidId', 'marca',
             'modelo', 'android', 'sdk', 'activo', 'ultimaConexion'
           ]);

      // Al volver a entrar se actualiza todo menos "uid", que es la
      // pertenencia del documento: si se pudiera cambiar, un usuario
      // podria robarle el equipo a otra cuenta escribiendolo.
      allow update: if esAdmin() || (
        request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
      );

      allow delete: if esAdmin();
    }

    // =================================================================
    // /conversaciones/{conversacionId}
    // Las directas y los grupos.
    //
    // Solo se ve una conversacion si se es parte de ella. Antes esta regla
    // decia "allow read: if request.auth != null", o sea que CUALQUIER
    // cuenta autenticada (y la sesion es anonima, asi que cualquiera que
    // instale la app) podia abrir la conversacion de otra persona y leer
    // todos sus mensajes. Aqui se cierra.
    // =================================================================
    match /conversaciones/{conversacionId} {

      allow read: if esAdmin() || soyParticipante(conversacionId);

      // ---------------------------------------------------------------
      // /conversaciones/{id}/miembros/{uid}
      //
      // Un documento por participante. Es el que hace posible que las
      // consultas ("dame mis conversaciones") funcionen sin abrir un
      // holes de seguridad: la pertenencia esta en la RUTA del documento,
      // y las reglas pueden comprobarla sin leer el documento entero.
      //
      // El campo "participantes" del documento padre sigue guardandose
      // porque lo necesita la app para pintar el grupo, pero ya no decide
      // el acceso: eso lo hace esta subcoleccion.
      // ---------------------------------------------------------------
      match /miembros/{uid} {
        allow read: if esAdmin() || miUid() == uid;

        // Quien puede crear la conversacion da de alta a los miembros
        // iniciales. Despues, anadir o quitar gente pasa por la app, que
        // comprueba que quien llama es administrador antes de escribir.
        //
        // La comprobacion es que el uid siga estando en la lista del
        // documento padre: asi nadie puede colarse en la subcoleccion
        // "miembros" de una conversacion ajena declarandose a si mismo
        // participante.
        allow create: if miUid() == uid && (
          esAdmin()
          || soyAdminDe(conversacionId)
          || uid in get(/databases/$(database)/documents/conversaciones/$(conversacionId))
                  .data.participantes.split(',')
        );

        allow update: if esAdmin() || miUid() == uid;

        allow delete: if esAdmin() || soyAdminDe(conversacionId);
      }

      // Crear: se exige que uno mismo este en la lista y que los campos
      // tengan la forma esperada. Nadie crea una conversacion en la que no
      // participa.
      allow create: if request.auth != null
        && miUid() in request.resource.data.participantes.split(',')
        && request.resource.data.keys().hasAll([
             'participantes', 'tipo', 'nombre', 'creado'
           ])
        && request.resource.data.keys().hasOnly([
             'participantes', 'tipo', 'nombre', 'descripcion', 'fotoUrl',
             'otroNumero', 'creado', 'actualizado', 'administradores',
             'ultimoMensaje', 'ultimoMensajeAutor', 'ultimoMensajeHora'
           ])
        && request.resource.data.tipo in ['directa', 'grupo']
        && request.resource.data.participantes.size() <= 256;

      // Editar: un participante puede cambiar el nombre y la descripcion
      // de un grupo, pero NO la lista de participantes ni los
      // administradores con un update normal. Meter a alguien en un grupo
      // (o quitarlo) pasa por las funciones de la app, que vuelven a
      // comprobar que quien llama es administrador. Si se permitiera aqui,
      // cualquier miembro podria ascenderse a administrador escribiendo el
      // documento entero.
      allow update: if esAdmin() || (
        soyParticipante(conversacionId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'nombre', 'descripcion', 'fotoUrl', 'ultimoMensaje',
               'ultimoMensajeAutor', 'ultimoMensajeHora', 'actualizado'
             ])
        // Anadir o quitar participantes y cambiar administradores solo lo
        // hace un administrador del grupo. Sin esta comprobacion, un
        // miembro cualquiera podria reescribir la lista y quedarse con el
        // control del grupo.
        || (
          soyAdminDe(conversacionId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['participantes', 'administradores', 'actualizado'])
        )
      );

      allow delete: if esAdmin() || soyAdminDe(conversacionId);

      // ---------------------------------------------------------------
      // /conversaciones/{id}/ajustes/{uid}
      // Silenciado, fijado, archivado y etiqueta: personales.
      //
      // El id del documento ES el uid, asi que cada quien escribe solo en
      // el suyo. Silenciar un grupo es cosa mia, no de los demas.
      // ---------------------------------------------------------------
      match /ajustes/{uid} {
        allow read: if esAdmin() || miUid() == uid;
        allow write: if request.auth != null && miUid() == uid;
      }

      // ---------------------------------------------------------------
      // /conversaciones/{id}/tecleando/{uid}
      // El "esta escribiendo..." de cada persona.
      //
      // Va en su propio subdocumento para que dos personas escribiendo a
      // la vez no se pisen: cada una escribe la suya y nada mas.
      // ---------------------------------------------------------------
      match /tecleando/{uid} {
        allow read: if esAdmin() || soyParticipante(conversacionId);
        allow write: if request.auth != null
          && miUid() == uid
          && soyParticipante(conversacionId);
      }
    }

    // =================================================================
    // /mensajes/{conversacionId}/mensaje/{mensajeId}
    //
    // Solo los del chat. El estado de entrega se puede tocar con reglas
    // distintas segun quien lo escribe:
    //  - el autor marca "entregado" y "leido" de sus propios mensajes,
    //  - el que recibe marca "leido" de los que le llegan.
    // =================================================================
    match /mensajes/{conversacionId}/mensaje/{mensajeId} {
      allow read: if esAdmin() || soyParticipante(conversacionId);

      allow create: if soyParticipante(conversacionId)
        && request.resource.data.autor == miUid()
        && request.resource.data.keys().hasAll([
             'autor', 'texto', 'creado'
           ])
        && request.resource.data.keys().hasOnly([
             'conversacion', 'autor', 'autorNombre', 'texto', 'tipo',
             'creado', 'creadoMs', 'estado', 'respondeA',
             'textoRespondido', 'autorRespondido', 'reenviadoDe',
             'urlImagen', 'nombreArchivo', 'eliminado', 'destacado',
             'expira'
           ])
        && request.resource.data.texto is string
        && request.resource.data.texto.size() <= 8000;

      allow update: if esAdmin() || (
        soyParticipante(conversacionId)
        && (
          // El autor ajusta el estado de lo que escribio.
          (resource.data.autor == miUid()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado']))
          // Cualquier participante puede marcar como leido, porque lo
          // leido lo marca el que recibe, no el que escribe.
          || (request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado'])
              && request.resource.data.estado == 'leido')
          // El autor puede borrar para todos y destacar sus mensajes.
          || (resource.data.autor == miUid()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['eliminado', 'texto', 'urlImagen', 'textoRespondido', 'destacado']))
        )
      );

      allow delete: if esAdmin() || (
        soyParticipante(conversacionId) && resource.data.autor == miUid()
      );
    }

    // =================================================================
    // /negocios/{uid}
    // Perfil comercial, catalogo, respuestas y etiquetas.
    //
    // Todo esto es PUBLICO, como el escaparate de una tienda: cualquiera
    // autenticado lo puede ver para saber a que se dedica la cuenta. Pero
    // escribir es solo del dueno.
    //
    // OJO con "activo": NO esta en la lista de campos que se pueden
    // cambiar con un update normal. El interruptor de cuenta de empresa se
    // controla aparte, en /usuarios/{uid}, y las reglas de ahi obligan a
    // que los dos sitios digan lo mismo. Asi nadie puede encender su
    // catalogo por la puerta de atrás sin pasar por la cuenta.
    // =================================================================
    match /negocios/{uid} {

      allow read: if request.auth != null;

      allow create: if miUid() == uid;

      allow update: if miUid() == uid && (
        // El interruptor "activo" SÍ se puede cambiar aquí, y solo por el
        // dueño. Es lo que hace posible el botón de activar/desactivar
        // empresa. No queda ningún hueco: quien lo cambia es el propio
        // dueño de su catálogo, así que no puede afectar a nadie más.
        request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['activo', 'actualizado'])
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'nombreComercial', 'descripcion', 'categoria', 'direccion',
               'telefono', 'correo', 'sitioWeb', 'instagram', 'facebook',
               'horario', 'abierto', 'mensajeBienvenida', 'mensajeAusencia',
               'etiquetaPorDefecto', 'actualizado'
             ])
      );

      allow delete: if esAdmin() || miUid() == uid;

      // Catalogo de productos.
      match /catalogo/{productoId} {
        allow read: if request.auth != null;
        allow write: if miUid() == uid;
      }

      // Respuestas rapidas.
      match /respuestas/{respuestaId} {
        allow read: if request.auth != null;
        allow write: if miUid() == uid;
      }

      // Etiquetas de las conversaciones.
      match /etiquetas/{etiquetaId} {
        allow read: if request.auth != null;
        allow write: if miUid() == uid;
      }
    }

    // =================================================================
    // /bloqueos/{uid}/bloqueados/{otroUid}
    // A quien tiene bloqueado cada persona.
    //
    // Vive bajo el uid del que bloquea, asi que la lista es privada:
    // nadie mas ve a quien tienes bloqueado.
    // =================================================================
    match /bloqueos/{uid} {
      allow read, write: if esAdmin() || miUid() == uid;

      match /bloqueados/{otroUid} {
        allow read: if esAdmin() || miUid() == uid;
        allow write: if esAdmin() || miUid() == uid;
      }
    }

    // =================================================================
    // /reportes/{id}
    // Denuncias de usuarios.
    //
    // Quien denuncia puede ver SU denuncia para saber que se envio.
    // El administrador ve todas. Nadie mas.
    // =================================================================
    match /reportes/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
             'reportadoUid', 'reportadaPor', 'motivo', 'detalle', 'creado'
           ])
        && request.resource.data.reportadaPor == miUid()
        && request.resource.data.reportadoUid != miUid();

      allow read: if esAdmin() || (
        request.auth != null && resource.data.reportadaPor == miUid()
      );

      allow update, delete: if esAdmin();
    }

    // =================================================================
    // /config/{documento}
    // El admin publica aqui los numeros autorizados.
    // =================================================================
    match /config/{documento} {
      allow read: if true;
      allow write: if esAdmin();
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}