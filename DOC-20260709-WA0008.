/* ============================================================
   DESCARGA CON NOMBRE ÚNICO
   ============================================================ */
let lastDownloadKey = '';
let lastDownloadCount = 0;
$('#downloadBtn').addEventListener('click', ()=>{
  if(!lastCanvas) return;
  const now = new Date();
  const dd = pad2(now.getDate());
  const mm = pad2(now.getMonth()+1);
  const aa = pad2(now.getFullYear()%100);
  const hh = pad2(now.getHours());
  const mi = pad2(now.getMinutes());
  const ss = pad2(now.getSeconds());
  const key = `${dd}${mm}${aa}${hh}${mi}${ss}`;

  if(key===lastDownloadKey){
    lastDownloadCount++;
  }else{
    lastDownloadKey = key;
    lastDownloadCount = 0;
  }
  const suffix = lastDownloadCount>0 ? `_${pad2(lastDownloadCount)}` : '';
  const filename = `QRLIMBERW${key}${suffix}.png`;

  lastCanvas.toBlob(blob=>{
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showToast('Descargado como '+filename);
  }, 'image/png');
});

