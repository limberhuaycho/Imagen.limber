<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QR Studio · Generador y Lector de QR</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode-generator/1.4.4/qrcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
<style>
:root{
  --bg:#f4f6fb;
  --card:#ffffff;
  --ink:#1b1f2a;
  --muted:#6b7280;
  --blue:#2563eb;
  --violet:#7c3aed;
  --line:#e6e9f2;
  --shadow:0 10px 30px -12px rgba(30,41,59,.18);
  --radius:18px;
  --radius-sm:12px;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  font-family:'Segoe UI',system-ui,-apple-system,Roboto,Helvetica,Arial,sans-serif;
  background:
    radial-gradient(1200px 600px at 10% -10%, rgba(37,99,235,.10), transparent),
    radial-gradient(1000px 500px at 110% 10%, rgba(124,58,237,.10), transparent),
    var(--bg);
  color:var(--ink);
  min-height:100vh;
  padding:24px 16px 60px;
}
.wrap{max-width:1040px;margin:0 auto;}
header.top{
  display:flex; align-items:center; justify-content:space-between; gap:16px;
  margin-bottom:22px; flex-wrap:wrap;
}
.brand{display:flex; align-items:center; gap:12px;}
.brand .logo-mark{
  width:44px;height:44px;border-radius:12px;
  background:linear-gradient(135deg,var(--blue),var(--violet));
  display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;
  box-shadow:var(--shadow);
}
.brand h1{font-size:20px;margin:0;letter-spacing:.2px;}
.brand p{margin:0;color:var(--muted);font-size:13px;}

.tabs{
  display:flex;gap:6px;background:#eef1f8;padding:6px;border-radius:14px;
}
.tab-btn{
  border:none;background:transparent;padding:10px 18px;border-radius:10px;
  font-size:14px;font-weight:600;color:var(--muted);cursor:pointer;
  transition:all .25s ease;
}
.tab-btn.active{
  background:#fff;color:var(--ink);box-shadow:var(--shadow);
}
.tab-btn:hover{color:var(--ink);}

.panel{display:none;animation:fadeIn .35s ease;}
.panel.active{display:block;}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

.grid{
  display:grid;grid-template-columns:1fr 1fr;gap:20px;
}
@media(max-width:820px){.grid{grid-template-columns:1fr;}}

.card{
  background:var(--card);border-radius:var(--radius);padding:22px;
  box-shadow:var(--shadow);border:1px solid var(--line);
}
.card h2{margin:0 0 14px;font-size:16px;}
.field{margin-bottom:14px;}
.field label{display:block;font-size:13px;font-weight:600;color:var(--muted);margin-bottom:6px;}
.field input[type=text],
.field input[type=number],
.field input[type=email],
.field input[type=tel],
.field input[type=date],
.field input[type=time],
.field input[type=url],
.field textarea,
.field select{
  width:100%;padding:11px 13px;border-radius:var(--radius-sm);
  border:1.5px solid var(--line);font-size:14px;font-family:inherit;
  background:#fbfcff;transition:border-color .2s, box-shadow .2s;
  color:var(--ink);
}
.field textarea{min-height:110px;resize:vertical;}
.field input:focus,.field select:focus,.field textarea:focus{
  outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.12);
}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(max-width:480px){.row2{grid-template-columns:1fr;}}

.chip-group{display:flex;gap:8px;flex-wrap:wrap;}
.chip{
  padding:9px 14px;border-radius:999px;border:1.5px solid var(--line);
  background:#fbfcff;font-size:13px;font-weight:600;cursor:pointer;color:var(--muted);
  transition:all .2s ease;
}
.chip:hover{border-color:var(--blue);color:var(--ink);}
.chip.active{
  background:linear-gradient(135deg,var(--blue),var(--violet));
  color:#fff;border-color:transparent;box-shadow:0 6px 16px -6px rgba(37,99,235,.55);
}
.color-dot{
  width:34px;height:34px;border-radius:50%;border:2.5px solid #fff;
  box-shadow:0 0 0 1.5px var(--line);cursor:pointer;transition:transform .2s;
}
.color-dot:hover{transform:scale(1.1);}
.color-dot.active{box-shadow:0 0 0 2.5px var(--ink);}
.color-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}

.btn{
  border:none;border-radius:var(--radius-sm);padding:12px 20px;font-size:14px;font-weight:700;
  cursor:pointer;transition:transform .15s ease, box-shadow .15s ease, opacity .15s ease;
  display:inline-flex;align-items:center;gap:8px;
}
.btn:active{transform:scale(.97);}
.btn-primary{
  background:linear-gradient(135deg,var(--blue),var(--violet));color:#fff;
  box-shadow:0 8px 20px -8px rgba(37,99,235,.6);
}
.btn-primary:hover{box-shadow:0 10px 24px -8px rgba(37,99,235,.75);}
.btn-outline{
  background:#fff;color:var(--ink);border:1.5px solid var(--line);
}
.btn-outline:hover{border-color:var(--blue);color:var(--blue);}
.btn-block{width:100%;justify-content:center;}
.btn[disabled]{opacity:.5;cursor:not-allowed;}

.preview-card{display:flex;flex-direction:column;align-items:center;gap:16px;}
.qr-stage{
  width:100%;display:flex;align-items:center;justify-content:center;
  background:
    linear-gradient(135deg,#fbfcff,#f1f4fb);
  border-radius:var(--radius);padding:18px;min-height:280px;
  border:1.5px dashed var(--line);
}
#qrCanvas{max-width:100%;height:auto;border-radius:10px;}
.hint{color:var(--muted);font-size:12.5px;text-align:center;}
.logo-options{display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;}
.file-btn{
  display:inline-flex;align-items:center;gap:8px;padding:9px 14px;border-radius:var(--radius-sm);
  border:1.5px dashed var(--line);cursor:pointer;font-size:13px;font-weight:600;color:var(--muted);
  background:#fbfcff;
}
.file-btn:hover{border-color:var(--blue);color:var(--blue);}
.file-btn input{display:none;}

.icon{width:18px;height:18px;flex:none;}

.scan-choice{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px;}
.scan-choice .btn{flex:1;min-width:170px;}
#readerBox{
  width:100%;border-radius:var(--radius);overflow:hidden;border:1.5px solid var(--line);
  display:none;background:#000;
}
#readerBox.active{display:block;}
#qr-reader{width:100%;}

.result-card{
  margin-top:18px;border-radius:var(--radius);border:1.5px solid var(--line);
  background:linear-gradient(180deg,#fbfcff,#fff);padding:20px;display:none;
  animation:fadeIn .35s ease;
}
.result-card.active{display:block;}
.result-top{display:flex;align-items:center;gap:10px;margin-bottom:12px;}
.result-badge{
  background:linear-gradient(135deg,var(--blue),var(--violet));color:#fff;font-size:12px;
  font-weight:700;padding:5px 12px;border-radius:999px;
}
.result-row{
  display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px solid var(--line);
  font-size:14px;
}
.result-row:last-of-type{border-bottom:none;}
.result-row .k{color:var(--muted);font-weight:600;min-width:110px;}
.result-row .v{text-align:right;word-break:break-word;}
.result-actions{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;}
.content-box{
  background:#f6f8fd;border-radius:var(--radius-sm);padding:12px 14px;font-size:13.5px;
  white-space:pre-wrap;word-break:break-word;margin-top:8px;color:#374151;
}
footer{text-align:center;color:var(--muted);font-size:12px;margin-top:30px;}

.toast{
  position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(20px);
  background:var(--ink);color:#fff;padding:12px 20px;border-radius:12px;font-size:13.5px;
  box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:all .3s ease;z-index:999;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <div class="brand">
      <div class="logo-mark">QR</div>
      <div>
        <h1>QR Studio</h1>
        <p>Generador y lector de códigos QR</p>
      </div>
    </div>
    <div class="tabs">
      <button class="tab-btn active" data-tab="gen">Generar QR</button>
      <button class="tab-btn" data-tab="read">Leer QR</button>
    </div>
  </header>

  <!-- ================= GENERAR ================= -->
  <section class="panel active" id="panel-gen">
    <div class="grid">
      <div>
        <div class="card">
          <h2>1. Tipo de contenido</h2>
          <div class="field">
            <select id="typeSelect">
              <option value="text">Texto plano</option>
              <option value="url">URL o enlace</option>
              <option value="tel">Número telefónico</option>
              <option value="email">Correo electrónico</option>
              <option value="sms">SMS</option>
              <option value="whatsapp">WhatsApp</option>
              <option value="telegram">Telegram</option>
              <option value="geo">Ubicación</option>
              <option value="wifi">WiFi</option>
              <option value="vcard">Tarjeta de contacto (vCard)</option>
              <option value="event">Evento de calendario</option>
              <option value="payment">Información de pagos</option>
              <option value="crypto">Criptomonedas</option>
            </select>
          </div>
          <div id="dynamicFields"></div>
        </div>

        <div class="card" style="margin-top:18px;">
          <h2>2. Estilo del QR</h2>
          <div class="chip-group" id="styleChips">
            <button class="chip active" data-style="classic">QR Clásico</button>
            <button class="chip" data-style="rounded">QR Redondeado</button>
            <button class="chip" data-style="heart">QR Corazón</button>
            <button class="chip" data-style="heartframe">QR en Corazón</button>
          </div>
          <div style="margin-top:14px;">
            <label style="display:block;font-size:13px;font-weight:600;color:var(--muted);margin-bottom:8px;">Color</label>
            <div class="color-row" id="colorRow"></div>
          </div>
        </div>

        <div class="card" style="margin-top:18px;">
          <h2>3. Logotipo central</h2>
          <div class="chip-group">
            <button class="chip" data-logo="none">Sin imagen</button>
            <button class="chip active" data-logo="lr">Usar logo LR</button>
            <button class="chip" data-logo="custom">Elegir imagen</button>
          </div>
          <div class="logo-options">
            <label class="file-btn" id="logoFileBtn" style="display:none;">
              <input type="file" id="logoFile" accept="image/*">
              📁 Seleccionar imagen desde la computadora
            </label>
          </div>
        </div>

        <button class="btn btn-primary btn-block" id="generateBtn" style="margin-top:20px;">✨ Generar código QR</button>
      </div>

      <div>
        <div class="card preview-card">
          <div class="qr-stage"><canvas id="qrCanvas" width="360" height="360"></canvas></div>
          <p class="hint">El tamaño se ajusta automáticamente según la cantidad de información. Nivel de corrección de errores: alto (H).</p>
          <button class="btn btn-outline btn-block" id="downloadBtn" disabled>⬇️ Descargar PNG</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= LEER ================= -->
  <section class="panel" id="panel-read">
    <div class="card">
      <h2>Leer código QR</h2>
      <div class="scan-choice">
        <button class="btn btn-primary" id="camBtn">📷 Desde cámara</button>
        <label class="btn btn-outline" for="galleryFile" style="cursor:pointer;">🖼️ Desde galería
          <input type="file" id="galleryFile" accept="image/*" style="display:none;">
        </label>
      </div>
      <div id="readerBox"><div id="qr-reader"></div></div>
      <div class="result-card" id="resultCard">
        <div class="result-top">
          <span class="result-badge" id="resTypeBadge">Tipo</span>
        </div>
        <div id="resultRows"></div>
        <div class="content-box" id="resultContentBox"></div>
        <div class="result-actions" id="resultActions"></div>
      </div>
    </div>
  </section>

  <footer>QR Studio — creado con HTML, CSS y JavaScript puro.</footer>
</div>

<div class="toast" id="toast"></div>

<script>
/* ============================================================
   LOGO POR DEFECTO (LR) EN BASE64
   ============================================================ */
const DEFAULT_LOGO_SRC = "data:image/jpeg;base64,";

/* ============================================================
   UTILIDADES
   ============================================================ */
function $(sel,ctx){return (ctx||document).querySelector(sel);}
function $all(sel,ctx){return Array.from((ctx||document).querySelectorAll(sel));}
function esc(s){return (s||"").toString();}
function showToast(msg){
  const t=$('#toast'); t.textContent=msg; t.classList.add('show');
  clearTimeout(showToast._tm);
  showToast._tm=setTimeout(()=>t.classList.remove('show'),2600);
}
function pad2(n){return n.toString().padStart(2,'0');}

/* ============================================================
   TABS
   ============================================================ */
$all('.tab-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    $all('.tab-btn').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    $all('.panel').forEach(p=>p.classList.remove('active'));
    $('#panel-'+btn.dataset.tab).classList.add('active');
    if(btn.dataset.tab!=='read'){ stopCamera(); }
  });
});

/* ============================================================
   CAMPOS DINÁMICOS POR TIPO
   ============================================================ */
const FIELhoneypot = null;
const FIELD_DEFS = {
  text: [{id:'text_value',label:'Texto',type:'textarea',placeholder:'Escribe cualquier texto...'}],
  url: [{id:'url_value',label:'URL',type:'text',placeholder:'https://ejemplo.com'}],
  tel: [{id:'tel_value',label:'Número (con código de país)',type:'text',placeholder:'+59170000000'}],
  email: [
    {id:'email_to',label:'Correo',type:'text',placeholder:'correo@ejemplo.com'},
    {id:'email_subject',label:'Asunto',type:'text',placeholder:'Asunto del mensaje'},
    {id:'email_body',label:'Mensaje',type:'textarea',placeholder:'Escribe el mensaje...'}
  ],
  sms: [
    {id:'sms_number',label:'Número',type:'text',placeholder:'+59170000000'},
    {id:'sms_message',label:'Mensaje',type:'textarea',placeholder:'Escribe el mensaje...'}
  ],
  whatsapp: [
    {id:'wa_number',label:'Número (con código de país) o pega tu link',type:'text',placeholder:'+59170000000 ó https://wa.me/59170000000'},
    {id:'wa_message',label:'Mensaje predeterminado (opcional)',type:'textarea',placeholder:'Hola, quiero más información...'}
  ],
  telegram: [
    {id:'tg_user',label:'Usuario de Telegram o pega tu link',type:'text',placeholder:'usuario ó https://t.me/usuario'}
  ],
  geo: [
    {id:'geo_lat',label:'Latitud',type:'text',placeholder:'-17.783300'},
    {id:'geo_lng',label:'Longitud',type:'text',placeholder:'-63.182100'}
  ],
  wifi: [
    {id:'wifi_ssid',label:'Nombre de red (SSID)',type:'text',placeholder:'MiRedWiFi'},
    {id:'wifi_pass',label:'Contraseña',type:'text',placeholder:'••••••••'},
    {id:'wifi_sec',label:'Tipo de seguridad',type:'select',options:[['WPA','WPA'],['WPA2','WPA2'],['WPA3','WPA3'],['WEP','WEP'],['nopass','Sin contraseña']]}
  ],
  vcard: [
    {id:'vc_nombre',label:'Nombre',type:'text'},
    {id:'vc_apellido',label:'Apellido',type:'text'},
    {id:'vc_empresa',label:'Empresa',type:'text'},
    {id:'vc_cargo',label:'Cargo',type:'text'},
    {id:'vc_tel',label:'Teléfono',type:'text'},
    {id:'vc_cel',label:'Celular',type:'text'},
    {id:'vc_email',label:'Correo',type:'text'},
    {id:'vc_web',label:'Sitio web',type:'text'},
    {id:'vc_dir',label:'Dirección',type:'text'},
    {id:'vc_ciudad',label:'Ciudad',type:'text'},
    {id:'vc_pais',label:'País',type:'text'}
  ],
  event: [
    {id:'ev_titulo',label:'Título',type:'text'},
    {id:'ev_lugar',label:'Lugar',type:'text'},
    {id:'ev_fecha_ini',label:'Fecha inicio',type:'date'},
    {id:'ev_hora_ini',label:'Hora inicio',type:'time'},
    {id:'ev_fecha_fin',label:'Fecha fin',type:'date'},
    {id:'ev_hora_fin',label:'Hora fin',type:'time'},
    {id:'ev_desc',label:'Descripción',type:'textarea'}
  ],
  payment: [
    {id:'pay_nombre',label:'Nombre',type:'text'},
    {id:'pay_banco',label:'Banco',type:'text'},
    {id:'pay_cuenta',label:'Cuenta',type:'text'},
    {id:'pay_ref',label:'Referencia',type:'text'},
    {id:'pay_monto',label:'Monto',type:'text'},
    {id:'pay_obs',label:'Observaciones',type:'textarea'}
  ],
  crypto: [
    {id:'cr_moneda',label:'Criptomoneda',type:'select',options:[['bitcoin','Bitcoin'],['ethereum','Ethereum'],['litecoin','Litecoin'],['usdt','USDT'],['solana','Solana']]},
    {id:'cr_dir',label:'Dirección',type:'text'},
    {id:'cr_monto',label:'Cantidad (opcional)',type:'text'}
  ]
};

function renderFields(type){
  const cont = $('#dynamicFields');
  cont.innerHTML = '';
  const defs = FIELD_DEFS[type] || [];
  defs.forEach(f=>{
    const wrap = document.createElement('div');
    wrap.className='field';
    let inner = `<label for="${f.id}">${f.label}</label>`;
    if(f.type==='textarea'){
      inner += `<textarea id="${f.id}" placeholder="${f.placeholder||''}"></textarea>`;
    }else if(f.type==='select'){
      inner += `<select id="${f.id}">` + f.options.map(o=>`<option value="${o[0]}">${o[1]}</option>`).join('') + `</select>`;
    }else{
      inner += `<input type="${f.type}" id="${f.id}" placeholder="${f.placeholder||''}">`;
    }
    wrap.innerHTML = inner;
    cont.appendChild(wrap);
  });
}
$('#typeSelect').addEventListener('change', e=>renderFields(e.target.value));
renderFields('text');

/* ============================================================
   CONSTRUCCIÓN DEL CONTENIDO SEGÚN TIPO
   ============================================================ */
function val(id){ const el=document.getElementById(id); return el? el.value.trim() : ''; }

function buildData(type){
  switch(type){
    case 'text':
      return val('text_value');
    case 'url':{
      let u = val('url_value');
      if(u && !/^https?:\/\//i.test(u)) u = 'https://'+u;
      return u;
    }
    case 'tel':
      return 'tel:'+val('tel_value').replace(/\s+/g,'');
    case 'email':{
      const to=val('email_to'), subj=encodeURIComponent(val('email_subject')), body=encodeURIComponent(val('email_body'));
      return `mailto:${to}?subject=${subj}&body=${body}`;
    }
    case 'sms':
      return `SMSTO:${val('sms_number')}:${val('sms_message')}`;
    case 'whatsapp':{
      let v = val('wa_number');
      if(!v) return '';
      if(/^https?:\/\//i.test(v)) return v; // ya es un link, no autocompletar
      const digits = v.replace(/[^\d]/g,'');
      const msg = val('wa_message');
      return `https://wa.me/${digits}` + (msg ? `?text=${encodeURIComponent(msg)}` : '');
    }
    case 'telegram':{
      let v = val('tg_user');
      if(!v) return '';
      if(/^https?:\/\//i.test(v)) return v; // ya es un link, no autocompletar
      const user = v.replace(/^@/,'').trim();
      return `https://t.me/${user}`;
    }
    case 'geo':
      return `geo:${val('geo_lat')},${val('geo_lng')}`;
    case 'wifi':{
      const ssid=val('wifi_ssid'), pass=val('wifi_pass'), sec=val('wifi_sec');
      const secTag = sec==='nopass' ? 'nopass' : sec;
      return `WIFI:T:${secTag};S:${ssid};P:${sec==='nopass'?'':pass};;`;
    }
    case 'vcard':{
      return [
        'BEGIN:VCARD','VERSION:3.0',
        `N:${val('vc_apellido')};${val('vc_nombre')};;;`,
        `FN:${val('vc_nombre')} ${val('vc_apellido')}`,
        val('vc_empresa') ? `ORG:${val('vc_empresa')}` : '',
        val('vc_cargo') ? `TITLE:${val('vc_cargo')}` : '',
        val('vc_tel') ? `TEL;TYPE=WORK,VOICE:${val('vc_tel')}` : '',
        val('vc_cel') ? `TEL;TYPE=CELL:${val('vc_cel')}` : '',
        val('vc_email') ? `EMAIL:${val('vc_email')}` : '',
        val('vc_web') ? `URL:${val('vc_web')}` : '',
        (val('vc_dir')||val('vc_ciudad')||val('vc_pais')) ? `ADR:;;${val('vc_dir')};${val('vc_ciudad')};;;${val('vc_pais')}` : '',
        'END:VCARD'
      ].filter(Boolean).join('\n');
    }
    case 'event':{
      const fmt=(d,t)=> (d? d.replace(/-/g,'') : '') + 'T' + (t? t.replace(/:/g,'')+'00' : '000000');
      return [
        'BEGIN:VEVENT',
        `SUMMARY:${val('ev_titulo')}`,
        val('ev_lugar') ? `LOCATION:${val('ev_lugar')}` : '',
        `DTSTART:${fmt(val('ev_fecha_ini'),val('ev_hora_ini'))}`,
        `DTEND:${fmt(val('ev_fecha_fin')||val('ev_fecha_ini'),val('ev_hora_fin'))}`,
        val('ev_desc') ? `DESCRIPTION:${val('ev_desc')}` : '',
        'END:VEVENT'
      ].filter(Boolean).join('\n');
    }
    case 'payment':{
      return [
        'INFORMACIÓN DE PAGO',
        val('pay_nombre') && `Nombre: ${val('pay_nombre')}`,
        val('pay_banco') && `Banco: ${val('pay_banco')}`,
        val('pay_cuenta') && `Cuenta: ${val('pay_cuenta')}`,
        val('pay_ref') && `Referencia: ${val('pay_ref')}`,
        val('pay_monto') && `Monto: ${val('pay_monto')}`,
        val('pay_obs') && `Observaciones: ${val('pay_obs')}`
      ].filter(Boolean).join('\n');
    }
    case 'crypto':{
      const moneda = val('cr_moneda');
      const dir = val('cr_dir');
      const monto = val('cr_monto');
      const scheme = {bitcoin:'bitcoin',ethereum:'ethereum',litecoin:'litecoin',usdt:'usdt',solana:'solana'}[moneda] || 'bitcoin';
      return `${scheme}:${dir}` + (monto ? `?amount=${monto}` : '');
    }
    default: return '';
  }
}

