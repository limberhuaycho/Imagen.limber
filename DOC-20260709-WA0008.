let html5QrCode = null;
let cameraActive = false;

function stopCamera(){
  if(html5QrCode && cameraActive){
    html5QrCode.stop().then(()=>{
      html5QrCode.clear();
      cameraActive=false;
      $('#readerBox').classList.remove('active');
    }).catch(()=>{});
  }
}

$('#camBtn').addEventListener('click', async ()=>{
  const box = $('#readerBox');
  if(cameraActive){ stopCamera(); $('#camBtn').textContent='📷 Desde cámara'; return; }
  box.classList.add('active');
  $('#qr-reader').innerHTML = '';
  html5QrCode = new Html5Qrcode('qr-reader');
  try{
    await html5QrCode.start(
      { facingMode: 'environment' },
      { fps: 10, qrbox: { width: 250, height: 250 } },
      (decodedText)=>{ handleScanResult(decodedText); },
      ()=>{}
    );
    cameraActive = true;
    $('#camBtn').textContent = '⏹️ Detener cámara';
  }catch(err){
    showToast('No se pudo acceder a la cámara.');
    box.classList.remove('active');
  }
});

$('#galleryFile').addEventListener('change', async e=>{
  const file = e.target.files[0];
  if(!file) return;
  const tempId = 'qr-reader-file-temp';
  let tempDiv = document.getElementById(tempId);
  if(!tempDiv){
    tempDiv = document.createElement('div');
    tempDiv.id = tempId;
    tempDiv.style.display = 'none';
    document.body.appendChild(tempDiv);
  }
  const scanner = new Html5Qrcode(tempId);
  try{
    const result = await scanner.scanFile(file, true);
    handleScanResult(result);
  }catch(err){
    showToast('No se pudo leer ningún código QR en la imagen.');
  }finally{
    try{ scanner.clear(); }catch(e2){}
  }
  e.target.value = '';
});

/* ============================================================
   INTERPRETACIÓN DEL RESULTADO
   ============================================================ */
function handleScanResult(text){
  stopCamera();
  $('#camBtn').textContent = '📷 Desde cámara';
  const now = new Date();
  const fecha = `${pad2(now.getDate())}/${pad2(now.getMonth()+1)}/${now.getFullYear()}`;
  const hora = `${pad2(now.getHours())}:${pad2(now.getMinutes())}:${pad2(now.getSeconds())}`;

  let tipo = 'Texto';
  let rows = [];
  let actions = [];

  if(/^https?:\/\/(wa\.me|api\.whatsapp\.com)\//i.test(text)){
    tipo = 'WhatsApp';
    actions.push(`<a class="btn btn-primary" href="${text}" target="_blank" rel="noopener">💬 Abrir WhatsApp</a>`);
  }else if(/^https?:\/\/t\.me\//i.test(text)){
    tipo = 'Telegram';
    actions.push(`<a class="btn btn-primary" href="${text}" target="_blank" rel="noopener">✈️ Abrir Telegram</a>`);
  }else if(/^https?:\/\//i.test(text)){
    tipo = 'URL / Enlace';
    actions.push(`<a class="btn btn-primary" href="${text}" target="_blank" rel="noopener">🔗 Abrir enlace</a>`);
  }else if(/^tel:/i.test(text)){
    tipo = 'Teléfono';
    const num = text.replace(/^tel:/i,'');
    rows.push(['Número', num]);
    actions.push(`<a class="btn btn-primary" href="${text}">📞 Llamar</a>`);
  }else if(/^mailto:/i.test(text)){
    tipo = 'Correo electrónico';
    actions.push(`<a class="btn btn-primary" href="${text}">✉️ Enviar correo</a>`);
  }else if(/^SMSTO:/i.test(text)){
    tipo = 'SMS';
    const parts = text.split(':');
    rows.push(['Número', parts[1]||'']);
    rows.push(['Mensaje', parts.slice(2).join(':')||'']);
  }else if(/^geo:/i.test(text)){
    tipo = 'Ubicación';
    const coords = text.replace(/^geo:/i,'');
    rows.push(['Coordenadas', coords]);
    actions.push(`<a class="btn btn-primary" href="https://www.google.com/maps?q=${coords}" target="_blank" rel="noopener">🗺️ Abrir en Google Maps</a>`);
  }else if(/^WIFI:/i.test(text)){
    tipo = 'Red WiFi';
    const get = (k)=>{ const m=text.match(new RegExp(k+':([^;]*)')); return m?m[1]:''; };
    rows.push(['SSID', get('S')]);
    rows.push(['Seguridad', get('T')]);
    rows.push(['Contraseña', get('P')]);
  }else if(/^BEGIN:VCARD/i.test(text)){
    tipo = 'Tarjeta de contacto';
    const get = (k)=>{ const m=text.match(new RegExp(k+':([^\\n\\r]*)')); return m?m[1]:''; };
    rows.push(['Nombre', get('FN')]);
    rows.push(['Empresa', get('ORG')]);
    rows.push(['Teléfono', get('TEL;TYPE=WORK,VOICE') || get('TEL')]);
    rows.push(['Correo', get('EMAIL')]);
  }else if(/^BEGIN:VEVENT/i.test(text)){
    tipo = 'Evento de calendario';
    const get = (k)=>{ const m=text.match(new RegExp(k+':([^\\n\\r]*)')); return m?m[1]:''; };
    rows.push(['Título', get('SUMMARY')]);
    rows.push(['Lugar', get('LOCATION')]);
    rows.push(['Inicio', get('DTSTART')]);
    rows.push(['Fin', get('DTEND')]);
    rows.push(['Descripción', get('DESCRIPTION')]);
  }else if(/^(bitcoin|ethereum|litecoin|usdt|solana):/i.test(text)){
    tipo = 'Criptomoneda';
    const scheme = text.split(':')[0];
    rows.push(['Moneda', scheme]);
    rows.push(['Dirección', text.split(':')[1]?.split('?')[0] || '']);
  }else{
    tipo = 'Texto plano';
  }

  rows.push(['Longitud', text.length + ' caracteres']);
  rows.push(['Fecha', fecha]);
  rows.push(['Hora', hora]);
  rows.push(['Formato', tipo]);

  $('#resTypeBadge').textContent = tipo;
  $('#resultRows').innerHTML = rows.map(([k,v])=>`<div class="result-row"><span class="k">${k}</span><span class="v">${esc(v)}</span></div>`).join('');
  $('#resultContentBox').textContent = text;
  $('#resultActions').innerHTML = actions.join('');
  $('#resultCard').classList.add('active');
  showToast('Código QR leído correctamente.');
}
