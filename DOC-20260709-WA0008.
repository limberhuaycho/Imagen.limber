function drawRoundedRect(ctx,x,y,w,h,r){
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
  ctx.fill();
}

function drawHeartPath(ctx,cx,cy,size){
  // dibuja un corazón real (silueta clásica) centrado en (cx,cy), ancho/alto ~= size
  const x = cx - size/2;
  const y = cy - size/2;
  const topCurveHeight = size*0.32;
  ctx.beginPath();
  ctx.moveTo(cx, y + topCurveHeight);
  // lóbulo superior izquierdo
  ctx.bezierCurveTo(cx, y, x, y, x, y + topCurveHeight);
  // curva inferior izquierda hacia la punta
  ctx.bezierCurveTo(x, y + (size + topCurveHeight) / 2, cx, y + (size + topCurveHeight) / 1.4, cx, y + size);
  // curva inferior derecha desde la punta
  ctx.bezierCurveTo(cx, y + (size + topCurveHeight) / 1.4, x + size, y + (size + topCurveHeight) / 2, x + size, y + topCurveHeight);
  // lóbulo superior derecho
  ctx.bezierCurveTo(x + size, y, cx, y, cx, y + topCurveHeight);
  ctx.closePath();
  ctx.fill();
}

function isFinderModule(row,col,count){
  const inTL = row<7 && col<7;
  const inTR = row<7 && col>=count-7;
  const inBL = row>=count-7 && col<7;
  return inTL || inTR || inBL;
}

// dibuja el "ojo" (posición): cuadrado externo + punto interno.
// En estilo "classic" se dibuja con esquinas rectas (el QR tradicional que casi todos usan);
// en el resto de estilos se usan esquinas redondeadas.
function drawEye(ctx, x, y, cellSize, color, style){
  const outer = cellSize*7;
  const isClassic = (style==='classic');
  const r1 = isClassic ? 0 : cellSize*1.6;
  const r2 = isClassic ? 0 : cellSize*1.1;
  ctx.fillStyle = color;
  drawRoundedRect(ctx, x, y, outer, outer, r1);
  ctx.fillStyle = '#ffffff';
  drawRoundedRect(ctx, x+cellSize, y+cellSize, outer-cellSize*2, outer-cellSize*2, r1*0.7);
  ctx.fillStyle = color;
  drawRoundedRect(ctx, x+cellSize*2, y+cellSize*2, outer-cellSize*4, outer-cellSize*4, r2);
}

function buildQRModel(dataStr){
  const qr = qrcode(0, 'H');
  qr.addData(dataStr, 'Byte');
  qr.make();
  return qr;
}

function renderQR(dataStr, style, color){
  if(!dataStr){ showToast('Completa los campos antes de generar el QR.'); return null; }
  const qr = buildQRModel(dataStr);
  const count = qr.getModuleCount();

  const cell = 10; // tamaño base por módulo
  const quiet = 4; // zona de silencio en módulos
  const inner = count*cell;
  const margin = quiet*cell;

  const isFrame = (style==='heartframe');
  const canvasSize = isFrame ? inner + margin*2 + Math.round(inner*0.5) : inner + margin*2;

  const canvas = document.createElement('canvas');
  canvas.width = canvasSize;
  canvas.height = canvasSize;
  const ctx = canvas.getContext('2d');

  // fondo blanco
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(0,0,canvasSize,canvasSize);

  const offsetX = (canvasSize - inner)/2;
  const offsetY = (canvasSize - inner)/2;

  // Si es "QR en corazón": dibujar corazón decorativo grande de fondo primero
  if(isFrame){
    ctx.save();
    ctx.globalAlpha = 0.9;
    // corazón grande de contorno relleno con textura de puntos, detrás del QR
    const heartSize = canvasSize*0.98;
    // máscara: dibujamos muchos corazones pequeños dispersos dentro del área del corazón grande,
    // pero fuera del cuadro donde irá el QR real.
    const cx = canvasSize/2, cy = canvasSize/2 + canvasSize*0.03;
    // función para saber si un punto está dentro del corazón grande (aprox, usando ecuación implícita)
    function inHeart(px,py){
      const x = (px-cx)/(heartSize*0.5);
      const y = -(py-cy)/(heartSize*0.5) + 0.25;
      const eq = Math.pow(x*x+y*y-1,3) - x*x*y*y*y;
      return eq <= 0;
    }
    const qrLeft = offsetX-margin*0.4, qrTop = offsetY-margin*0.4, qrRight = offsetX+inner+margin*0.4, qrBottom = offsetY+inner+margin*0.4;
    ctx.fillStyle = color;
    const step = cell*0.85;
    let seed = 42;
    function rnd(){ seed = (seed*9301+49297)%233280; return seed/233280; }
    for(let py=0; py<canvasSize; py+=step){
      for(let px=0; px<canvasSize; px+=step){
        const jx = px + (rnd()-0.5)*step*0.6;
        const jy = py + (rnd()-0.5)*step*0.6;
        if(jx>=qrLeft && jx<=qrRight && jy>=qrTop && jy<=qrBottom) continue; // deja libre el área del QR
        if(inHeart(jx,jy) && rnd()>0.25){
          drawHeartPath(ctx, jx, jy, step*0.85*(0.6+rnd()*0.5));
        }
      }
    }
    ctx.restore();
  }

  // Dibujar módulos del QR
  for(let row=0; row<count; row++){
    for(let col=0; col<count; col++){
      if(!qr.isDark(row,col)) continue;
      const x = offsetX + col*cell;
      const y = offsetY + row*cell;
      ctx.fillStyle = color;

      if(isFinderModule(row,col,count)){
        continue; // los ojos se dibujan aparte
      }

      if(style==='classic'){
        ctx.fillRect(x, y, cell, cell);
      } else if(style==='rounded'){
        drawRoundedRect(ctx, x+cell*0.08, y+cell*0.08, cell*0.84, cell*0.84, cell*0.32);
      } else { // heart / heartframe -> módulos en forma de corazón
        drawHeartPath(ctx, x+cell/2, y+cell/2, cell*1.05);
      }
    }
  }

  // Dibujar los 3 ojos de posición encima, estilo moderno unificado
  const eyePositions = [[0,0],[0,count-7],[count-7,0]];
  eyePositions.forEach(([r,c])=>{
    drawEye(ctx, offsetX+c*cell, offsetY+r*cell, cell, color, style);
  });

  // Logotipo central
  const wantsLogo = logoMode!=='none';
  const logoImg = wantsLogo ? ((logoMode==='custom' && customLogoImg) ? customLogoImg : defaultLogoImg) : null;
  if(logoImg){
    // Tamaño del logo en CANTIDAD FIJA DE MÓDULOS (no en % del área), igual en todos los QR.
    // Así, en un QR con muchos módulos el logo se ve proporcionalmente más pequeño y en uno
    // con pocos módulos se ve proporcionalmente más grande (igual que apps de pago tipo Yape).
    // Se limita a un máximo seguro (~30% del ancho) para no romper la lectura con corrección H.
    const LOGO_MODULES = 20;
    const logoModules = Math.min(LOGO_MODULES, Math.floor(count*0.30));
    const logoSize = logoModules*cell;
    const lx = offsetX + inner/2 - logoSize/2;
    const ly = offsetY + inner/2 - logoSize/2;
    const pad = logoSize*0.14;
    ctx.fillStyle = '#ffffff';
    drawRoundedRect(ctx, lx-pad, ly-pad, logoSize+pad*2, logoSize+pad*2, (logoSize+pad*2)*0.22);
    ctx.save();
    drawRoundedRect(ctx, lx, ly, logoSize, logoSize, logoSize*0.18);
    ctx.clip();
    ctx.drawImage(logoImg, lx, ly, logoSize, logoSize);
    ctx.restore();
  }

  return canvas;
}

