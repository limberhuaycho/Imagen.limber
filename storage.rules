rules_version = '2';

// =====================================================================
//  Appv2 - Reglas de Cloud Storage
//  Solo imagenes de perfil y de chat. Nada de documentos ni ejecutables.
// =====================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'limberhuaychoquispe81@gmail.com';
    }

    function dueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function imagenValida() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ---------------------------------------------------------------
    // /perfiles/{uid}/...
    // ---------------------------------------------------------------
    match /perfiles/{uid}/{archivo} {
      allow read: if request.auth != null;
      allow write: if dueno(uid) && imagenValida();
    }

    // ---------------------------------------------------------------
    // /mensajes/{conversacionId}/{uid}/{archivo}
    // El nombre incluye el uid, asi solo el autor puede subir a su
    // propia carpeta. Cualquiera autenticado puede leer las imagenes
    // del chat.
    // ---------------------------------------------------------------
    match /mensajes/{conversacionId}/{uid}/{archivo} {
      allow read: if request.auth != null;
      allow write: if dueno(uid) && imagenValida();
      allow delete: if dueno(uid) || esAdmin();
    }

    // ---------------------------------------------------------------
    // /catalogo/{uid}/{archivo}
    // Las fotos de los productos del catalogo de una empresa.
    //
    // Se pueden leer sin restricciones: el catalogo es publico, es como
    // el escaparate de una tienda, y cualquiera autenticado tiene que
    // poder ver que vende esa empresa antes de escribirle.
    //
    // Escribir es solo del dueno, y solo imagenes: el limite de 5 MB se
    // aplica tambien aqui para que nadie suba un vídeo de un gigabyte a
    // la carpeta del catalogo.
    // ---------------------------------------------------------------
    match /catalogo/{uid}/{archivo} {
      allow read: if request.auth != null;
      allow write: if dueno(uid) && imagenValida();
      allow delete: if dueno(uid) || esAdmin();
    }

    // ---------------------------------------------------------------
    // /grupos/{grupoId}/{uid}/{archivo}
    // La foto de un grupo.
    // ---------------------------------------------------------------
    match /grupos/{grupoId}/{uid}/{archivo} {
      allow read: if request.auth != null;
      allow write: if dueno(uid) && imagenValida();
      allow delete: if dueno(uid) || esAdmin();
    }

    // ---------------------------------------------------------------
    // /admin/...
    // Contenido del panel de administracion.
    // ---------------------------------------------------------------
    match /admin/{todo=**} {
      allow read: if request.auth != null;
      allow write: if esAdmin() && imagenValida();
    }

    // Resto de rutas cerrado.
    match /{todo=**} {
      allow read, write: if false;
    }
  }
}